SUB2API_IMAGE=ghcr.io/mengfei0053/sub2api-ebeeai
SUB2API_VERSION=0.1.127_0.0.2
SUB2API_CONTAINER_NAME=sub2api
SUB2API_BIND_HOST=0.0.0.0
SUB2API_HOST_PORT=8080
SUB2API_DATA_DIR=/opt/sub2api/docker-data

ONEPANEL_NETWORK=1panel-network

DATABASE_HOST=postgresql
DATABASE_PORT=5432
DATABASE_USER=user_4swtMX
DATABASE_PASSWORD=change-me
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-existing-config-yaml-redis-password
REDIS_DB=0
REDIS_ENABLE_TLS=false

JWT_SECRET=replace-with-existing-config-yaml-jwt-secret
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

RUN_MODE=standard
TZ=Asia/Shanghai

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false

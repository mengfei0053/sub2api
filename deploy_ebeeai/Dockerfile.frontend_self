# syntax=docker/dockerfile:1

# Vite emits static files, so the Node builder runs once on BUILDPLATFORM
# (native on the GitHub runner). Only the nginx runtime is built per target
# arch. pnpm install and the Vite build are not run under QEMU.

ARG NODE_IMAGE=node:24-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS frontend-builder

WORKDIR /app/frontend_self

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY frontend_self/package.json frontend_self/pnpm-lock.yaml frontend_self/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend_self/ ./
COPY docs/legal /app/docs/legal

ENV VITE_OUT_DIR=dist
RUN pnpm run build

# Default platform is TARGETPLATFORM (per-arch nginx). Do not pin
# $TARGETPLATFORM; `docker buildx build --check` rejects that as redundant.
FROM ${NGINX_IMAGE} AS runtime

LABEL org.opencontainers.image.title="sub2api-ebeeai-app"
LABEL org.opencontainers.image.description="EbeeAI app SPA (frontend_self) for split deployment"
LABEL org.opencontainers.image.source="https://github.com/Wei-Shaw/sub2api"

COPY deploy_ebeeai/nginx/frontend-self.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-builder /app/frontend_self/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -T 3 -O /dev/null http://127.0.0.1/ || exit 1

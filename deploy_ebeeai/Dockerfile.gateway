# syntax=docker/dockerfile:1

# Thin config-only image. There is no compile step; each published arch uses
# that platform's nginx image. `rm` is the only command QEMU may emulate.

ARG NGINX_IMAGE=nginx:1.27-alpine

# Default platform is TARGETPLATFORM. Do not pin $TARGETPLATFORM;
# `docker buildx build --check` rejects that as redundant.
FROM ${NGINX_IMAGE}

LABEL org.opencontainers.image.title="sub2api-ebeeai-gateway"
LABEL org.opencontainers.image.description="Path router for EbeeAI split deployment"
LABEL org.opencontainers.image.source="https://github.com/Wei-Shaw/sub2api"

RUN rm -f /etc/nginx/conf.d/default.conf

COPY deploy_ebeeai/nginx/gateway.conf /etc/nginx/conf.d/gateway.conf
COPY deploy_ebeeai/nginx/gateway-ai-stream.conf /etc/nginx/conf.d/gateway-ai-stream.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -T 3 -O /dev/null http://127.0.0.1/health || exit 1
